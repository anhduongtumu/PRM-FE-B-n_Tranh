<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="?attr/colorSurfaceContainerHigh"/>
    <!--
        A common color for received messages is a light gray or a
        slightly darker shade than the chat background.
        ?attr/colorSurfaceContainerHigh is a good Material Design token.
        You can replace with e.g. android:color="#E0E0E0"
        or a custom color: android:color="@color/my_received_bubble_bg"
    -->

    <corners
        android:topLeftRadius="4dp"
        android:topRightRadius="16dp"
        android:bottomLeftRadius="16dp"
        android:bottomRightRadius="16dp"/>
    <!--
        Adjust these values for the desired bubble shape.
        For received messages, often the top-left or bottom-left
        is less rounded to give a "tail" pointing towards the sender.
    -->
</shape>